# wg0.conf.tmpl - template for r1 WireGuard interface
# variables: SERVER_PRIV (private key), populated by cloud-init/router.yaml
# peer stanzas are appended by gen-peers.sh output during provisioning.
[Interface]
PrivateKey = __SERVER_PRIV__
Address = 10.80.255.1/16
ListenPort = 51820
MTU = 1420
# WireGuard listens on 51820 internally; wstunnel forwards TCP:443 -> 127.0.0.1:51820.
# No UDP:443 iptables redirect needed; NSG allows both UDP and TCP 443 from 0.0.0.0/0.
PostUp = sysctl -w net.ipv4.ip_forward=1; sysctl -w net.ipv4.conf.all.forwarding=1
PostUp = sysctl -w net.core.rmem_max=26214400; sysctl -w net.core.wmem_max=26214400
PostDown = true
