#!/usr/bin/env bash
# h7 - team tooling for model C vulnboxes
# Usage: h7 <command> [args]
#
# Commands:
#   status              show all services and their deploy state
#   deploy <svc>        force a deploy from the team repo's current HEAD
#   rollback <svc> [prev|orig]  roll back to previous or original image
#   logs <svc> [--since <d>] [--follow]  stream prod logs
#   diff <svc>          show code diff between prev and current sha
#   local-up            spin up all services locally for testing
#   local-down          stop local test stack
#   ps                  list running prod containers with stats
#
# The deployer API is at H7D_API (default http://127.0.0.1:9100).
# Bearer token from H7D_TOKEN env or /etc/h7/box.env (BOX_TOKEN).

set -euo pipefail

H7D_API="${H7D_API:-http://127.0.0.1:9300}"
H7D_TOKEN="${H7D_TOKEN:-}"

# load token from box.env if not set
if [[ -z "$H7D_TOKEN" && -f /etc/h7/box.env ]]; then
  BOX_TOKEN=$(grep '^BOX_TOKEN=' /etc/h7/box.env 2>/dev/null | cut -d= -f2- || true)
  H7D_TOKEN="${BOX_TOKEN:-}"
fi

api() {
  local method="$1" path="$2"
  shift 2
  local args=("-s" "-f" "-X" "$method" "${H7D_API}${path}")
  if [[ -n "$H7D_TOKEN" ]]; then
    args+=("-H" "Authorization: Bearer $H7D_TOKEN")
  fi
  args+=("$@")
  curl "${args[@]}"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  status)
    echo "=== h7 status ==="
    api GET /deploys | python3 -c "
import json,sys,time
data=json.load(sys.stdin)
now=int(time.time())
for svc,s in sorted(data.items()):
    age=now-s.get('promoted_at',now)
    mode=s.get('mode','pipeline')
    print(f\"  {svc:<24} sha={s.get('sha','?')[:8]}  deploys={s.get('deploys',0)}  mode={mode}  age={age//60}m\")
" 2>/dev/null || api GET /deploys
    echo ""
    api GET /ps | python3 -c "
import json,sys
data=json.load(sys.stdin)
if isinstance(data,list):
  for c in data: print(f\"  {c.get('Name','?'):<30} {c.get('State','?'):<12} {c.get('Status','')}\")
else: print(data)
" 2>/dev/null || true
    ;;

  deploy)
    svc="${1:?usage: h7 deploy <service>}"
    # get HEAD sha from the team repo
    sha=$(git -C /srv/git/services.git rev-parse HEAD 2>/dev/null || \
          git rev-parse HEAD 2>/dev/null || echo "")
    if [[ -z "$sha" ]]; then
      echo "error: could not determine HEAD sha" >&2
      exit 1
    fi
    echo "queuing $svc @ ${sha:0:8} ..."
    api POST /push \
      -H "Content-Type: application/json" \
      -d "{\"service\":\"$svc\",\"sha\":\"$sha\"}" | python3 -c "
import json,sys; d=json.load(sys.stdin); print('queued:', d.get('queued','?'))
"
    ;;

  rollback)
    svc="${1:?usage: h7 rollback <service> [prev|orig]}"
    target="${2:-prev}"
    echo "rolling back $svc to $target ..."
    api POST "/rollback/${svc}?target=${target}" | python3 -c "
import json,sys; d=json.load(sys.stdin)
if d.get('ok'): print('rolled back ok, digest:', d.get('digest','?')[:19])
else: print('failed:', d)
"
    ;;

  logs)
    svc="${1:?usage: h7 logs <service> [--since 10m] [--follow]}"
    shift
    since="10m"
    follow=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --since) shift; since="$1" ;;
        -f|--follow) follow="&follow=1" ;;
      esac
      shift
    done
    # use curl streaming for logs
    curl -s -N ${H7D_TOKEN:+-H "Authorization: Bearer $H7D_TOKEN"} \
      "${H7D_API}/logs/${svc}?since=${since}${follow}"
    ;;

  diff)
    svc="${1:?usage: h7 diff <service>}"
    api GET "/diff/${svc}" 2>/dev/null || echo "(no diff available)"
    ;;

  deploys)
    api GET /deploys | python3 -c "
import json,sys,time
data=json.load(sys.stdin)
now=int(time.time())
hdr=f\"{'svc':<20}{'sha':<14}{'deploys':<10}{'mode':<12}{'age'}\"
print(hdr); print('-'*len(hdr))
for svc,s in sorted(data.items()):
    age=now-s.get('promoted_at',now)
    print(f\"{svc:<20}{s.get('sha','?')[:12]:<14}{s.get('deploys',0):<10}{s.get('mode','?'):<12}{age//60}m\")
" 2>/dev/null || api GET /deploys
    ;;

  ps)
    api GET /ps | python3 -c "
import json,sys
data=json.load(sys.stdin)
if isinstance(data,list):
  hdr=f\"{'Name':<32}{'State':<14}{'Status':<20}\"
  print(hdr); print('-'*len(hdr))
  for c in data: print(f\"{c.get('Name',''):<32}{c.get('State',''):<14}{c.get('Status',''):<20}\")
else: print(data)
" 2>/dev/null || api GET /ps
    ;;

  local-up)
    # spin up all services locally using their docker-compose.yml
    svc_root="${H7D_SVC_ROOT:-/opt/h7}"
    for d in "$svc_root"/*/; do
      svc=$(basename "$d")
      if [[ -f "$d/docker-compose.yml" ]]; then
        echo "starting $svc ..."
        docker compose -p "local-$svc" -f "$d/docker-compose.yml" up -d 2>&1 | tail -1
      fi
    done
    echo "local stack up. 'h7 local-down' to stop."
    ;;

  local-down)
    svc_root="${H7D_SVC_ROOT:-/opt/h7}"
    for d in "$svc_root"/*/; do
      svc=$(basename "$d")
      docker compose -p "local-$svc" down -v 2>/dev/null || true
    done
    echo "local stack down."
    ;;

  tick)
    api GET /tick | python3 -c "
import json,sys; d=json.load(sys.stdin)
print(f\"tick={d.get('tick','?')} offset={d.get('offset_s','?')}s quiet={'yes' if d.get('quiet') else 'no'}\")
"
    ;;

  help|--help|-h|"")
    cat <<'EOF'
h7 - team tools for model C AD

  h7 status                        service state + container status
  h7 deploy  <svc>                 trigger a deploy from repo HEAD
  h7 rollback <svc> [prev|orig]    roll back to previous or original image
  h7 logs    <svc> [--since 10m] [--follow]
  h7 diff    <svc>                 diff between prev and current sha
  h7 deploys                       deploy state for all services
  h7 ps                            running prod containers
  h7 local-up                      start all services locally for testing
  h7 local-down                    stop local test stack
  h7 tick                          current tick number and quiet-window status

Env: H7D_API (default http://127.0.0.1:9300), H7D_TOKEN, H7D_SVC_ROOT
EOF
    ;;

  *)
    echo "unknown command: $cmd (try h7 help)" >&2
    exit 1
    ;;
esac
