# Local development defaults. Replace every credential before any shared deployment.
ARGUS_ENV=development
INSTANCE_ID=team-a
ARGUS_K8S_NAMESPACE_PREFIX=argus
ARGUS_APP_IMAGE=argus:local
ARGUS_STATE_DIR=/var/lib/argus
# Local-only loopback publication. Anvil assigns the production route.
ARGUS_PORTAL_PORT=8080
ARGUS_PUBLIC_BASE_URL=http://localhost:8080
ARGUS_REGISTRY_BASE_URL=http://registry:8081
ARGUS_AGENTS_BASE_URL=http://agents:8082
ARGUS_DEPLOYMENT_BASE_URL=http://deployment:8084
ARGUS_MCP_BASE_URL=http://mcp:8083
ARGUS_A2A_INTERFACE_URL=http://portal:8080/message:send
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_DIGEST=
OLLAMA_SEED=7
OLLAMA_TEMPERATURE=0
ARGUS_MODEL_STRICT_JSON=true
ARGUS_APPROVAL_SIGNING_KEY=replace-with-a-long-random-value
ARGUS_APPROVAL_SIGNING_KEY_ID=argus-instance
ARGUS_WORKLOAD_IMAGE=argus:local
ARGUS_K8S_ENABLED=false
ARGUS_BOOTSTRAP_CONTROL_ID=control-team-a
ARGUS_BOOTSTRAP_TARGET=team-runtime

# These values are local development credentials only.
ARGUS_CREDENTIAL_PORTAL_REGISTRY=replace-portal-registry
ARGUS_CREDENTIAL_PORTAL_AGENTS=replace-portal-agents
ARGUS_CREDENTIAL_PORTAL_DEPLOYMENT=replace-portal-deployment
ARGUS_CREDENTIAL_REGISTRY_MCP=replace-registry-mcp
ARGUS_CREDENTIAL_AGENTS_REGISTRY=replace-agents-registry
ARGUS_CREDENTIAL_AGENTS_MCP=replace-agents-mcp
ARGUS_CREDENTIAL_AGENTS_COORDINATOR=replace-agents-coordinator
ARGUS_CREDENTIAL_COORDINATOR_SECURITY=replace-coordinator-security
